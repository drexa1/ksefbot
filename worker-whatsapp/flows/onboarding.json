{
    "version": "7.3",
    "data_api_version": "3.0",
    "routing_model": {
        "ONBOARDING_WELCOME": [
            "ONBOARDING_USER"
        ],
        "ONBOARDING_USER": [
            "ONBOARDING_CUSTOMER"
        ],
        "ONBOARDING_CUSTOMER": [
            "ONBOARDING_BANK"
        ],
        "ONBOARDING_BANK": [
            "ONBOARDING_SUCCESS"
        ],
        "ONBOARDING_SUCCESS": []
    },
    "screens": [
        {
            "id": "ONBOARDING_WELCOME",
            "title": "Let's start",
            "data": {},
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextBody",
                        "markdown": true,
                        "text": "**A few bits of information is all we need to start automating invoices:**\n\n1. The tax ID of your company and a KSeF token\n2. Optionally, the tax ID of your regular customer\n3. Optionally, your company's bank account"
                    },
                    {
                        "type": "Footer",
                        "label": "1. Your company",
                        "on-click-action": {
                            "name": "data_exchange",
                            "payload": {
                                "screen": "ONBOARDING_WELCOME",
                                "action": "start_onboarding"
                            }
                        }
                    }
                ]
            }
        },
        {
            "id": "ONBOARDING_USER",
            "title": "1. About your company",
            "data": {
                "company_name": {
                    "type": "string",
                    "__example__": ""
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "user_form",
                        "children": [
                            {
                                "type": "TextInput",
                                "required": true,
                                "label": "Company NIP",
                                "name": "company_nip",
                                "input-type": "number",
                                "helper-text": "10 digits — We will locate your company automatically."
                            },
                            {
                                "type": "TextBody",
                                "text": "Company: ${data.company_name}"
                            },
                            {
                                "type": "OptIn",
                                "name": "company_confirmed",
                                "label": "I confirm this is my company",
                                "required": true
                            },
                            {
                                "type": "TextInput",
                                "required": false,
                                "label": "Company main service",
                                "name": "default_item_name",
                                "helper-text": "Filling this now will save time later during invoice creation."
                            },
                            {
                                "type": "TextInput",
                                "required": true,
                                "label": "KSeF token",
                                "name": "ksef_token",
                                "input-type": "text"
                            },
                            {
                                "type": "TextBody",
                                "markdown": true,
                                "text": "You are not sure how to get a KSeF token? [Read more](https://ksefbot.druizbarbero.workers.dev/pages/onboarding/token)"
                            },
                            {
                                "type": "Footer",
                                "label": "2. Your customer",
                                "on-click-action": {
                                    "name": "data_exchange",
                                    "payload": {
                                        "screen": "ONBOARDING_USER",
                                        "action": "find_user_company",
                                        "company_nip": "${form.company_nip}",
                                        "company_confirmed": "${form.company_confirmed}",
                                        "default_item_name": "${form.default_item_name}",
                                        "ksef_token": "${form.ksef_token}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "ONBOARDING_CUSTOMER",
            "title": "2. About your customer",
            "data": {
                "customer_name": {
                    "type": "string",
                    "__example__": ""
                }
            },
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "Form",
                        "name": "customer_form",
                        "children": [
                            {
                                "type": "TextInput",
                                "required": false,
                                "label": "Customer NIP",
                                "name": "customer_nip",
                                "input-type": "number"
                            },
                            {
                                "type": "TextBody",
                                "text": "Customer: ${data.customer_name}"
                            },
                            {
                                "type": "OptIn",
                                "name": "customer_confirmed",
                                "label": "Is this your customer?",
                                "required": false
                            },
                            {
                                "type": "Footer",
                                "label": "3. Your company banking info",
                                "on-click-action": {
                                    "name": "data_exchange",
                                    "payload": {
                                        "screen": "ONBOARDING_CUSTOMER",
                                        "action": "find_customer_company",
                                        "customer_nip": "${form.customer_nip}",
                                        "customer_confirmed": "${form.customer_confirmed}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "ONBOARDING_BANK",
            "title": "3. Your company banking info",
            "data": {},
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextBody",
                        "text": "Filling this now will save time later during invoice creation."
                    },
                    {
                        "type": "Form",
                        "name": "bank_form",
                        "children": [
                            {
                                "type": "Dropdown",
                                "label": "Bank",
                                "name": "bank_name",
                                "required": false,
                                "data-source": [
                                    {
                                        "id": "ALIOR",
                                        "title": "Alior Bank SA"
                                    },
                                    {
                                        "id": "BNP",
                                        "title": "BNP Paribas Bank Polska SA"
                                    },
                                    {
                                        "id": "ING",
                                        "title": "ING Bank Śląski SA"
                                    },
                                    {
                                        "id": "MBANK",
                                        "title": "mBank SA"
                                    },
                                    {
                                        "id": "MILLENNIUM",
                                        "title": "Bank Millennium SA"
                                    },
                                    {
                                        "id": "PKOBP",
                                        "title": "PKO Bank Polski"
                                    },
                                    {
                                        "id": "SANTANDER",
                                        "title": "Santander Bank Polska"
                                    }
                                ]
                            },
                            {
                                "type": "TextInput",
                                "required": false,
                                "label": "Bank account",
                                "name": "account_number",
                                "input-type": "number"
                            },
                            {
                                "type": "RadioButtonsGroup",
                                "name": "notification_day",
                                "label": "Select when you want to be notified about invoicing",
                                "required": true,
                                "data-source": [
                                    {
                                        "id": "LAST_DAY",
                                        "title": "Last day of each month"
                                    },
                                    {
                                        "id": "FIRST_DAY",
                                        "title": "First day of the next month"
                                    },
                                    {
                                        "id": "MID_DAY",
                                        "title": "14th of each month"
                                    }
                                ]
                            },
                            {
                                "type": "Footer",
                                "label": "Finish",
                                "on-click-action": {
                                    "name": "data_exchange",
                                    "payload": {
                                        "screen": "ONBOARDING_BANK",
                                        "action": "finish_onboarding",
                                        "bank_name": "${form.bank_name}",
                                        "account_number": "${form.account_number}",
                                        "notification_day": "${form.notification_day}",
                                        "specific_day": "${form.specific_day}"
                                    }
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "ONBOARDING_SUCCESS",
            "title": "All done!",
            "terminal": true,
            "success": true,
            "data": {},
            "layout": {
                "type": "SingleColumnLayout",
                "children": [
                    {
                        "type": "TextBody",
                        "text": "We got all the required information to automatically start creating and submitting invoices.\n\nYou can change these settings at any moment."
                    },
                    {
                        "type": "Footer",
                        "label": "Done",
                        "on-click-action": {
                            "name": "complete",
                            "payload": {}
                        }
                    }
                ]
            }
        }
    ]
}