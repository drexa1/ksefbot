{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "bootstrap"],
    "paths": { "@wasm/*": ["./wasm/*"] }
  },
    "include": [
      "src/**/*",
      "tests/**/*",
      "worker-api/**/*"
    ],
  "exclude": ["node_modules"]
}