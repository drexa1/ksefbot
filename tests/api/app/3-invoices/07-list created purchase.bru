get {
    url: {{baseUrl}}/app/invoices?id={{purchaseInvoiceId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created purchases invoice", function() {
        expect(res.body[0].InvoiceBody.InvoiceNumber).to.equal(bru.getCollectionVar("purchaseInvoiceId"));
    })
}
script:post-response {
     bru.setCollectionVar("purchaseInvoiceContractorId", res.body[0].Seller.IdentificationData.NIP);
}