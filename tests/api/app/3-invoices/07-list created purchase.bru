get {
    url: {{baseUrl}}/app/invoices?id={{purchaseInvoiceId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created purchases invoice", function() {
        const invoice = JSON.parse(res.body[0].jsonData);
        expect(invoice.InvoiceBody.InvoiceNumber).to.equal(bru.getCollectionVar("purchaseInvoiceId"));
    })
}
script:post-response {
     const invoice = JSON.parse(res.body[0].jsonData);
     bru.setCollectionVar("purchaseInvoiceContractorId", invoice.Seller.IdentificationData.NIP);
}