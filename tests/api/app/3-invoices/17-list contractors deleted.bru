get {
    url: {{baseUrl}}/app/contractors
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List all contractors created should have been cleaned up", function() {
        expect(res.status).to.equal(404);
        expect(res.body).to.have.property("error", "Contractor not found");
    })
}