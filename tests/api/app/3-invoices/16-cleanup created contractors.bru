delete {
    url: {{baseUrl}}/app/contractors?id={{createdCustomerId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("Delete the contractor created by the invoice", function() {
        console.info(res.body);
        expect(res.status).to.equal(200);
        expect(res.body.changes).to.equal(1);
    })
}