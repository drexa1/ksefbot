get {
    url: {{baseUrl}}/app/invoices?id={{salesInvoiceId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created sales invoice", function() {
        console.info(res.body);
        const invoice = JSON.parse(res.body[0].jsonData);
        expect(invoice.InvoiceBody.InvoiceNumber).to.equal(bru.getCollectionVar("salesInvoiceId"));
    })
}
script:post-response {
     const invoice = JSON.parse(res.body[0].jsonData);
     bru.setCollectionVar("salesInvoiceCustomerId", invoice.Buyer.IdentificationData.NIP);
}