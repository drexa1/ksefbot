get {
    url: {{baseUrl}}/app/invoices?id={{salesInvoiceId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created sales invoice", function() {
        console.info(res.body);
        expect(res.body[0].InvoiceBody.InvoiceNumber).to.equal(bru.getCollectionVar("salesInvoiceId"));
    })
}
script:post-response {
     bru.setCollectionVar("salesInvoiceCustomerId", res.body[0].Buyer.IdentificationData.NIP);
}