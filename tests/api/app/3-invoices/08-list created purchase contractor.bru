get {
    url: {{baseUrl}}/app/contractors?nip={{purchaseInvoiceContractorId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created buyer contractor", function() {
        console.info(res.body);
        expect(res.body.error).to.equal("No contractor found");
    })
}