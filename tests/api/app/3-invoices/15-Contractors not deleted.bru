get {
    url: {{baseUrl}}/app/contractors
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List all customers created are still existing", function() {
        console.info(res.body);
        expect(res.status).to.equal(200);
        const customerId = bru.getCollectionVar("createdCustomerId");
        const contractorIds = res.body.map(contractor => contractor.id);
        expect(contractorIds).to.include(customerId);
        bru.setCollectionVar("remainingContractors", JSON.stringify(contractorIds.filter(id => id !== customerId)));
    })
}