post {
    url: {{baseUrl}}/app/invoices/ingest
    body: multipart-form
    auth: inherit
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
script:pre-request {
    const fs = require("fs");
    const xml = fs.readFileSync("../testresources/ksef-pii/purchases/5272710089-20260714-85064E400000-C7.anonymized.xml", "utf8");
    const body =
        `--ksefInvoice\n` +
        `Content-Disposition: form-data; name="file"; filename="purchases-invoice-1.xml"\n` +
        `Content-Type: application/xml\n` +
        `\n` +
        `${xml}\n` +
        `--ksefInvoice\n` +
        `Content-Disposition: form-data; name="type"\n` +
        `\n` +
        `purchase\n` +
        `--ksefInvoice\n` +
        `Content-Disposition: form-data; name="notes"\n` +
        `\n` +
        `Test notes\n` +
        `--ksefInvoice--`;
    req.setHeader("Content-Type", "multipart/form-data; boundary=ksefInvoice");
    req.setBody(body);
}
tests {
    test("Second attempt to create an existing purchases invoice should trigger PK violation error", function() {
        expect(res.status).to.equal(409);
    })
}