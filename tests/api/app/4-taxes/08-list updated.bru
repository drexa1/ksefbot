get {
    url: {{baseUrl}}/app/taxes?from={{taxRecordFrom}}&to={{taxRecordTo}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List a recently updated tax record should show the edition", function() {
        expect(res.body[0].notes).to.equal("edited");
    })
}