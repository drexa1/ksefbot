get {
    url: {{baseUrl}}/app/taxes
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List all tax records should find nothing", function() {
        expect(res.status).to.equal(404);
        expect(res.body).to.have.property("error", "No tax record found");
    })
}