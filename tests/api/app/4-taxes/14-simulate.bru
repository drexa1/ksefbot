get {
    url: {{baseUrl}}/app/taxes/simulate?hoursWorked=160
}
headers {
    X-API-Key: {{apiKey}}
}
tests {
    test("Simulate taxes using the seeded user's hourly rate", function() {
        expect(res.body.brutIncome).to.equal(25600);
        expect(res.body.purchasesSummary).to.be.an("array").that.is.empty;
        expect(res.body.healthContribution).to.be.a("number");  // We can't be more precise because depends on run date
        expect(res.body.totalCleanRevenue).to.be.a("number");
    });
}
