get {
    url: {{baseUrl}}/app/taxes/simulate?hoursWorked=160
}
headers {
    X-API-Key: {{apiKey}}
}
tests {
    test("Simulate taxes using the seeded user's hourly rate", function() {
        expect(res.status).to.equal(200);
        expect(res.body.hoursWorked).to.equal(160);
        expect(res.body.hourlyRate).to.equal(160);
        expect(res.body.brutIncome).to.equal(31488);
        expect(res.body.vatPercentage).to.equal(23);
        expect(res.body.vatAmount).to.equal(5888);
        expect(res.body.netBeforeObligations).to.equal(25600);
        expect(res.body.taxRate).to.equal(12);
        expect(res.body.incomeTax).to.equal(3072);
        expect(res.body.purchasesSummary).to.be.an("array").that.is.empty;
        expect(res.body.purchasesDeductions).to.equal(0);
        expect(res.body.healthContribution).to.be.a("number");  // ZUS bracket depends on the annual revenue and simulation period
        expect(res.body.totalCleanRevenue).to.equal(Number((res.body.netBeforeObligations - res.body.incomeTax - res.body.healthContribution + res.body.purchasesDeductions).toFixed(2)));
    });
}
