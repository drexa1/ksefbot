get {
    url: {{baseUrl}}/app/users?id={{userId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List a recently updated user should show the edition", function() {
        console.info(res.body);
        expect(res.body[0].bankName).to.equal("edited");
    })
}