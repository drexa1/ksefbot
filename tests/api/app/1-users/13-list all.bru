get {
    url: {{baseUrl}}/app/users
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List users after cleanup does not expose the super admin", function() {
        expect(res.status).to.equal(404);
        expect(res.body).to.deep.equal({ success: false, error: "No user found", filters: {} });
    })
}