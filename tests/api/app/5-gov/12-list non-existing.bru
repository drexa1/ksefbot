get {
    url: {{baseUrl}}/gov/contractors?nip=1234567890
}
headers {
    Accept: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("For non-existing NIP entrypoint lookup should fail (or report unavailable providers)", function() {
        if (res.status === 503)
            return console.warn(`🔌CEIDG service seems unavailable(${res.body.details}). Skipping`);
        expect(res.status).to.be.oneOf([404, 503]);
        expect(res.body.error).to.equal("Contractor not found");
    })
}