
get {
    url: {{baseUrl}}/gov/contractors?nip=6252447933&profile=customer
}
headers {
    Accept: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("For existing test company entrypoint lookup should prioritize KRS", function() {
        expect(res.body.source).to.equal("KRS");
        expect(res.body.addressLine).to.be.a("string").and.not.empty;
    })
}