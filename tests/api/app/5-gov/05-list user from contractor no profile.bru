get {
    url: {{baseUrl}}/gov/contractors?nip=7272445205
}
headers {
    Accept: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("For existing test sole proprietorship and no hint lookup should use CEIDG unless unavailable", async function() {
        const ceidg = await bru.sendRequest({
            url: `${bru.getEnvVar("baseUrl")}/gov/ceidg?nip=7272445205`,
            method: "GET",
            headers: { "X-API-Key": bru.getEnvVar("apiKey") }, validateStatus: () => true
        });
        if (ceidg.status === 503)
            console.warn("🔌 CEIDG seems unavailable. Expecting lookup fallback");
        console.info(res.body);
        expect(res.status).to.equal(200);
        expect(res.body.source).to.equal(ceidg.status === 503 ? "VAT-LB" : "CEIDG");
        expect(res.body.addressLine).to.be.a("string").and.not.empty;
    })
}