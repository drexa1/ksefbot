get {
    url: {{baseUrl}}/gov/vat-lb?nip=7272445205
}
headers {
    Accept: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("For existing test sole propietorship VAT payers whitelist should succeed", function() {
        expect(res.body.source).to.equal("VAT-LB");
        expect(res.body.addressLine).to.be.a("string").and.not.empty;
    })
}