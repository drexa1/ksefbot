get {
    url: {{baseUrl}}/gov/krs?nip=7272445205
}
headers {
    Accept: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("For existing test sole propietorship KRS should fail", function() {
        if (res.status === 503)
            return console.warn(`🔌 KRS temporarily unavailable (${res.body.details}). Skipping lookup assertions`);
        expect(res.status).to.equal(404);
        expect(res.body.error).to.contain("No KRS entry found for NIP");
    })
}