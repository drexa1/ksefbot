get {
    url: {{baseUrl}}/app/contractors?id={{contractor1Id}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List a recently updated contractor should show the edition", function() {
        console.info(res.body);
        expect(res.body[0].name).to.equal("edited");
    })
}