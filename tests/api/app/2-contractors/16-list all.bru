get {
    url: {{baseUrl}}/app/contractors
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List all contractors at the end should preserve seeded contractors", function() {
        expect(res.status).to.equal(200);
        expect(res.body.map(contractor => contractor.id)).to.have.members(JSON.parse(bru.getCollectionVar("populatedContractors")));
    })
}