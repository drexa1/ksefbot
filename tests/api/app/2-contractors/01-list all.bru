get {
    url: {{baseUrl}}/app/contractors
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List all contractors should find seeded contractors", function() {
        expect(res.status).to.equal(200);
        expect(res.body).to.be.an("array").that.is.not.empty;
        bru.setCollectionVar("populatedContractors", JSON.stringify(res.body.map(contractor => contractor.id)));
    })
}