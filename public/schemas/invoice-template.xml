<?xml version="1.0" encoding="utf-8"?>
<Faktura xmlns="http://crd.gov.pl/wzor/2025/06/25/13775/">
    <Naglowek>
        <KodFormularza kodSystemowy="FA (3)" wersjaSchemy="1-0E">{{FORM_CODE}}</KodFormularza>
        <WariantFormularza>3</WariantFormularza>
        <DataWytworzeniaFa>{{GENERATION_DATE}}</DataWytworzeniaFa>
        <SystemInfo>{{SYSTEM_INFO}}</SystemInfo>
    </Naglowek>
    <Podmiot1>
        <DaneIdentyfikacyjne>
            <NIP>{{CONTRACTOR_NIP}}</NIP>
            <Nazwa>{{CONTRACTOR_NAME}}</Nazwa>
        </DaneIdentyfikacyjne>
        <Adres>
            <KodKraju>{{COUNTRY_CODE}}</KodKraju>
            <AdresL1>{{CONTRACTOR_ADDRESS}}</AdresL1>
        </Adres>
        <DaneKontaktowe />
    </Podmiot1>
    <Podmiot2>
        <DaneIdentyfikacyjne>
            <NIP>{{CUSTOMER_NIP}}</NIP>
            <Nazwa>{{CUSTOMER_NAME}}</Nazwa>
        </DaneIdentyfikacyjne>
        <Adres>
            <KodKraju>{{COUNTRY_CODE}}</KodKraju>
            <AdresL1>{{CUSTOMER_ADDRESS}}</AdresL1>
        </Adres>
        <JST>{{JST}}</JST>
        <GV>{{GV}}</GV>
    </Podmiot2>
    <Fa>
        <KodWaluty>PLN</KodWaluty>
        <P_1>{{ISSUE_DATE}}</P_1>
        <P_1M>{{ISSUE_PLACE}}</P_1M>
        <P_2>{{INVOICE_NUMBER}}</P_2>
        <P_6>{{DELIVERY_DATE}}</P_6>
        <P_13_1>{{TOTAL_NET}}</P_13_1>
        <P_14_1>{{TOTAL_VAT}}</P_14_1>
        <P_15>{{TOTAL_GROSS}}</P_15>
        <Adnotacje>
            <P_16>{{CASH_ACCOUNTING}}</P_16>
            <P_17>{{SELF_BILLING}}</P_17>
            <P_18>{{REVERSE_CHARGE}}</P_18>
            <P_18A>{{MANDATORY_SPLIT_PAYMENT}}</P_18A>
            <Zwolnienie>
                <P_19N>{{VAT_EXEMPTION_NA}}</P_19N>
            </Zwolnienie>
            <NoweSrodkiTransportu>
                <P_22N>{{NEW_MEANS_TRANSPORT_NA}}</P_22N>
            </NoweSrodkiTransportu>
            <P_23>{{TRIANGULAR_TRANSACTION}}</P_23>
            <PMarzy>
                <P_PMarzyN>{{MARGIN_SCHEME_NA}}</P_PMarzyN>
            </PMarzy>
        </Adnotacje>
        <RodzajFaktury>VAT</RodzajFaktury>
        {{INVOICE_LINES}}
        <Platnosc>
            <TerminPlatnosci>
                <Termin>{{PAYMENT_DEADLINE}}</Termin>
            </TerminPlatnosci>
            <FormaPlatnosci>{{PAYMENT_TYPE}}</FormaPlatnosci>
            {{BANK_ACCOUNT}}
        </Platnosc>
    </Fa>
</Faktura>